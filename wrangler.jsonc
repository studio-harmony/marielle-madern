// Cloudflare Workers: de site is statisch; alleen /api/* gaat langs een kleine Worker (worker/index.mjs,
// bladmuziek per e-mail). Al het andere gaat rechtstreeks naar de bestanden. Die Worker doet niets (503) zolang
// de eigenaar de secrets en de R2-bucket niet heeft ingesteld, zie README.md, "Bladmuziek per e-mail".
// Handmatig uitrollen: pnpm run deploy (bouwt eerst met nuxt generate).
// Let op: `pnpm deploy` zonder `run` is een ander, ingebouwd pnpm-commando.
// Via GitHub (Workers Builds, zodra gekoppeld): een samenvoeging in main rolt uit,
// een branch of PR krijgt een eigen preview-adres.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mariellemadern",
  "main": "worker/index.mjs",
  "compatibility_date": "2025-07-15",
  // Preview-adres per versie. Blijft aan, ook als het workers.dev-adres na de livegang uitgaat.
  "preview_urls": true,
  // Verplicht voor `wrangler preview`, dat Workers Builds voor branches en PR's draait.
  // Leeg: een preview gebruikt dezelfde instellingen als hierboven en `assets` hieronder.
  "previews": {},
  "assets": {
    "directory": ".output/public",
    // De Worker krijgt alleen /api/*; voor al het andere blijft de Worker buiten beeld (en gratis)
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    // Onbekende URL's krijgen 404.html met status 404
    "not_found_handling": "404-page",
    // /over-mij wordt doorgestuurd naar /over-mij/ (de slash blijft de canonieke vorm)
    "html_handling": "auto-trailing-slash"
  },
  // De privé-bucket met de bladmuziek (pdf's als bladmuziek/<bestandsnaam van het nummer>.pdf). De Worker leest
  // alleen (get) en schrijft nooit. Een preview-bouw bindt dezelfde bucket (previews erft deze instellingen).
  "r2_buckets": [{ "binding": "BLADMUZIEK", "bucket_name": "marielle-madern" }],
  // Hostnamen waarop de Worker bladmuziek mag versturen, naast mariellemadern.nl en www.mariellemadern.nl (die staan als
  // code-constante in worker/bladmuziek.mjs). Besluit van de eigenaar, 2026-11-19: het formulier moet ook werken op het
  // hoofdadres https://mariellemadern.mmadern.workers.dev. Eén exacte hostnaam: geen wildcard en geen achtervoegsel, dus
  // de preview-adressen (die een andere hostnaam hebben, bijvoorbeeld preview-pr-35-mariellemadern.mmadern.workers.dev)
  // blijven 403. Dit is een gewone, niet-geheime variabele. De secrets (RESEND_API_KEY, TURNSTILE_SECRET) staan niet in
  // dit bestand maar alleen in het Cloudflare-dashboard. Zie README.md, "Het hoofdadres van de Worker".
  // CONTACT_AAN: 'aan' zet het contactformulier (POST /api/contact) aan; elke andere waarde, of de regel weghalen, geeft
  // 503 (dan toont het formulier de melding met hallo@mariellemadern.nl). Terugdraaien is dus één regel.
  "vars": { "TOEGESTANE_HOSTS": "mariellemadern.mmadern.workers.dev", "CONTACT_AAN": "aan" },
  // Limieten per minuut (de binding kent alleen perioden van 10 of 60 seconden): 3 per IP-adres, 1 per e-mailadres en
  // 10 voor de hele site. De Worker gebruikt als sleutel een HMAC van het IP-adres of e-mailadres; niets wordt bewaard.
  "ratelimits": [
    // Het contactformulier (/api/contact) heeft eigen limieten, los van de bladmuziek: zo blokkeert het ene formulier
    // het andere niet (een bezoeker met beide, of een stroom aanvragen voor de bladmuziek). 3 per IP-adres,
    // 1 per e-mailadres en 5 voor de hele site per minuut; een bericht kost twee mails (het Resend-plafond is
    // 100 per dag, gedeeld met de bladmuziek). Het eindpunt blijft uit tot CONTACT_AAN op 'aan' staat.
    { "name": "LIMIET_CONTACT_IP", "namespace_id": "1011", "simple": { "limit": 3, "period": 60 } },
    {
      "name": "LIMIET_CONTACT_ADRES",
      "namespace_id": "1012",
      "simple": { "limit": 1, "period": 60 }
    },
    {
      "name": "LIMIET_CONTACT_ALGEMEEN",
      "namespace_id": "1013",
      "simple": { "limit": 5, "period": 60 }
    },
    { "name": "LIMIET_IP", "namespace_id": "1003", "simple": { "limit": 3, "period": 60 } },
    { "name": "LIMIET_ADRES", "namespace_id": "1001", "simple": { "limit": 1, "period": 60 } },
    { "name": "LIMIET_ALGEMEEN", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  // Workers Logs uit: Cloudflare zet observability voor nieuwe Workers standaard aan en bewaart dan gegevens van
  // aanvragen (adres, tijdstip, status, 3 tot 7 dagen). Besluit van de eigenaar, 2026-11-24: niets bewaren. De Worker
  // schrijft zelf niets naar de console (geen console-aanroepen) en bewaart en logt geen naam of adres van bezoekers;
  // secrets staan niet in dit bestand. De sleutels staan er alle drie, zodat ook een standaardwaarde niets aanzet.
  "observability": {
    "enabled": false,
    "logs": { "enabled": false, "invocation_logs": false, "persist": false },
    "traces": { "enabled": false, "persist": false }
  }
}
